# Chain
EVM_CHAIN=xlayer
EVM_RPC_URL_XLAYER=http://your-xlayer-node:8545
EVM_WS_URL_XLAYER=ws://your-xlayer-node:8546

# Storage
DATABASE_URL=postgres://user:pass@host:5432/db   # indexer state (last block, reorg tracking)
CLICKHOUSE_HOST=your-clickhouse-host
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=evm

# Tuning
EVM_INDEXER_HISTORICAL_BATCH=1000
EVM_INDEXER_LIVE_THRESHOLD=1
EVM_BLOCK_BATCH_MAX_CONCURRENT_BLOCKS_XLAYER=16
EVM_BLOCK_BATCH_MAX_CONCURRENT_RECEIPTS_XLAYER=16
EVM_BLOCK_BATCH_MAX_CONCURRENT_TRACES_XLAYER=16
EVM_INDEXER_METRICS_ADDR=:19096
